# IntelliJ IDEA
.idea/
*.iml
*.iws
out/
*.ipr

# IntelliJ-specific files
# Optional: ignore workspace-specific and sensitive configs
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf

# Host-specific operator artifacts generated by bin/new-playbook.sh manual disk mode
playbooks/disk-setup-*.sh

# Secrets — only the ansible-vault ENCRYPTED vault/secrets.yaml may be committed;
# anything matching these patterns is unencrypted plaintext by convention.
vault/secrets.plain*.yaml
vault/*.dec.yaml
*.vault-pass*

# Ansible
*.retry
*.log
*.tar.gz
*.tmp
*.bak
*.swp
*.pyc
__pycache__/
vault_pass.txt
*.vault
inventory.ini
*.orig

# OS-generated files
.DS_Store
Thumbs.db

# Python virtual environments (if using)
venv/
.env/
.envrc

