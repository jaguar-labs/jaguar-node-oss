[main]
summary = Solana Validator Performance Profile
include = latency-performance

[variables]

{% if poh_pinned_cpu_core is defined %}
isolated_cores = {{ poh_pinned_cpu_core }}
isolated_cores_expanded = ${f:cpulist_unpack:${isolated_cores}}
isolated_cores_online_expanded = ${f:cpulist_online:${isolated_cores}}
non_isolated_cores = ${f:cpulist_invert:${isolated_cores}}
assert2 = ${f:assertion:isolated_cores contains online CPU(s):${isolated_cores_expanded}:${isolated_cores_online_expanded}}
{% endif %}

[cpu]
force_latency = 0
governor = performance
energy_perf_bias = performance
min_perf_pct = 100
max_perf_pct = 100

[disk-nvme]
type = disk
devices = nvme*
elevator = none
readahead = 2048

[sysctl]
# Increase max UDP buffer sizes
net.core.rmem_default = 134217728
net.core.rmem_max = 134217728
net.core.wmem_default = 134217728
net.core.wmem_max = 134217728
# net.core.optmem_max = 134217728

# 80KB ensures QUIC/gossip packets queue without drops—<1ms added latency.
# Smaller (64KB) risks retransmits, hurting latency more than throughput.
net.ipv4.udp_rmem_min = 81920
net.ipv4.udp_wmem_min = 81920

# Busy polling helps reduce latency in the network receive path
# by allowing socket layer code to poll the receive queue of a
# network device, and disabling network interrupts.
net.core.busy_read = 50
net.core.busy_poll = 50
  
# Increase backlog for high-throughput connections
net.core.netdev_max_backlog = 250000

# Disables prequeue timestamping—packets timestamped immediately (default 1).
net.core.netdev_tstamp_prequeue = 0

# Increase connection tracking timeouts slightly for better stability
net.netfilter.nf_conntrack_udp_timeout = 30

# Use fq_codel to manage queuing delays under load
net.core.default_qdisc = fq_codel

# eBPF
net.core.bpf_jit_enable = 1
net.core.bpf_jit_harden = 0
net.core.bpf_jit_kallsyms = 0

# IPv4

net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_ecn = 0
net.ipv4.route.flush = 1
net.ipv4.ip_no_pmtu_disc = 0
# turn off for 10Gb NICs to reduce CPU utilization
net.ipv4.tcp_timestamps = 1
# Enable selective acknowledgments 
net.ipv4.tcp_sack = 1
# Allows TCP to send "duplicate" SACKs
net.ipv4.tcp_dsack = 1

# Enable Early Retransmit. ER lowers the threshold for triggering fast retransmit when the amount of outstanding data is small and when no previously unsent data can be transmitted
net.ipv4.tcp_early_retrans = 3

net.ipv4.tcp_tw_recycle = 1
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_no_metrics_save = 1

# Because of the varying internet condition, not every connection is going to reach the optimal congestion window size, and that’s okay.
# To prevent slow link from using more than necessary amount of memory, we can use the following sysctl settings to enable receive buffer auto-tuning
net.ipv4.tcp_moderate_rcvbuf = 1

# Enable TCP/IP SYN cookies to 
net.ipv4.tcp_syncookies = 1

# SYN 
# Number of times SYNACKs for a passive TCP connection attempt will be retransmitted
net.ipv4.tcp_synack_retries = 5
# Number of times initial SYNs for an active TCP connection attempt	will be retransmitted
net.ipv4.tcp_syn_retries = 4

# The net.ipv4.tcp_fin_timeout parameter is the maximum time that a connection in the FIN-WAIT-2 state will stay open.
net.ipv4.tcp_fin_timeout = 15

# Allows the use of a large window (> 64 kB) on a TCP connection, this is the default settings for most modern kernel
net.ipv4.tcp_window_scaling = 1

# Set maximum window size to MAX_TCP_WINDOW i.e. 32767 in times there is no received window scaling option
net.ipv4.tcp_workaround_signed_windows = 1

# Increase the maximum queue length of completely established sockets waiting to be accepted
# The net.core.somaxconn parameter is the maximum queue length of completely established sockets waiting to be accepted.
net.core.somaxconn = 10000

# Increase the maximum queue length of incomplete sockets i.e. half-open connection
# The net.ipv4.tcp_max_syn_backlog parameter is the maximum queue length of incomplete sockets.
# NOTE: THis value should not be above "net.core.somaxconn", since that is also a hard open limit of maximum queue length of incomplete sockets/
# Kernel will take the lower one out of two as the maximum queue length of incomplete sockets
net.ipv4.tcp_max_syn_backlog = 10000

# The net.ipv4.tcp_max_tw_buckets parameter is the maximum number of sockets in TIME_WAIT state.
net.ipv4.tcp_max_tw_buckets = 10000

# net.ipv4.tcp_low_latency = 1
net.ipv4.tcp_adv_win_scale = 1

net.ipv4.icmp_echo_ignore_all = 1
# Do not accept ICMP redirects (prevent MITM attacks)
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0

# Do not send ICMP redirects (we are not a router)
net.ipv4.conf.all.send_redirects = 0

# Do not accept IP source route packets (we are not a router)
net.ipv4.conf.all.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
  
# Log Martian Packets
net.ipv4.conf.all.log_martians = 1

# Protect Against TCP TIME-WAIT Assassination
net.ipv4.tcp_rfc1337 = 0

# Disable packet forwarding
net.ipv4.ip_forward = 0

# Turn on Source Address Verification in all interfaces to prevent some spoofing attacks
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.rp_filter = 1
  
# Explicit TCP memory settings - Reduced Max from 16M to 12M for stability
net.ipv4.tcp_rmem = 8192 87380 12582912
net.ipv4.tcp_wmem = 4096 16384 12582912

# Kernel
kernel.timer_migration = 0
kernel.hung_task_timeout_secs = 30
kernel.nmi_watchdog = 0
kernel.watchdog = 0
kernel.numa_balancing = 0
kernel.sched_autogroup_enabled = 0
kernel.sched_cfs_bandwidth_slice_us = 500
kernel.sched_rt_runtime_us = 950000
kernel.sched_rt_period_us = 1000000
# restrict perf subsystem usage
kernel.perf_event_paranoid = 3
kernel.perf_cpu_time_max_percent = 1
kernel.perf_event_max_sample_rate = 1

# https://stackoverflow.com/a/65956131
kernel.unprivileged_bpf_disabled = 1

# VM: Latency tweaks
vm.swappiness = {{ sysctl_vm_swappiness | default(0) }}

# Increase memory mapped files limit
vm.max_map_count = 2000000
# increase interval from 1s to 100s
vm.stat_interval = 10
vm.dirty_ratio = 20
vm.dirty_background_ratio = 5
vm.min_free_kbytes = 3000000
vm.dirty_expire_centisecs = 6000
vm.dirty_writeback_centisecs = 500
vm.dirtytime_expire_seconds = 43200
# Disable proactive compaction because it introduces jitter
vm.compaction_proactiveness = 0
vm.zone_reclaim_mode = 0
vm.vfs_cache_pressure = 50
# Reduce the maximum page lock acquisition latency while retaining adequate throughput
vm.page_lock_unfairness = 1

# File descriptors
fs.file-max = 1000000
fs.nr_open = 1000000
# Increase Sync interval (default is 3000)
fs.xfs.xfssyncd_centisecs = 10000
fs.aio-max-nr = 2097152

[sysfs]
/sys/kernel/mm/ksm/run = 0
{% if cluster_environment != 'testnet' %}
/sys/kernel/mm/transparent_hugepage/enabled = never
/sys/kernel/mm/transparent_hugepage/defrag = never
/sys/kernel/mm/transparent_hugepage/khugepaged/defrag = 0
{% endif %}

[bootloader]
cmdline_solana_poh = {% if cluster_environment != 'testnet' %}nosmt {% endif %}idle=poll amd_pstate=active processor.max_cstate=0 mitigations=off preempt=full nvme_core.default_ps_max_latency_us=0 rcu_nocb_poll{% if poh_pinned_cpu_core is defined %} nohz=on nohz_full=${isolated_cores} rcu_nocbs=${isolated_cores} irqaffinity=${non_isolated_cores} isolcpus=${isolated_cores}{% endif %}
